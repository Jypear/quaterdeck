# Copy this file to .env and fill in your values.

# Django
# SECRET_KEY is required — the app won't start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with scheme) you'll submit forms from in production, e.g.
# CSRF_TRUSTED_ORIGINS=https://quaterdeck.example.com,http://192.168.1.50:8000
CSRF_TRUSTED_ORIGINS=

# Database
DB_NAME=quaterdeck
DB_USER=quaterdeck
DB_PASSWORD=quaterdeck
DB_HOST=localhost
DB_PORT=5432
